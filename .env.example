# Copy to .env and fill in to customize. NONE of these are required:
# - Real agents use the `codex` CLI (your ~/.codex login), not an env key.
# - With no codex CLI installed, everything runs on deterministic mock data.

# Weights & Biases / Weave -- unlocks live tracing in tracing.py
WANDB_API_KEY=

# Optional Codex overrides
# CODEX_MODEL=gpt-5.5         # force a specific model for codex exec
# CODEX_BIN=codex             # path/name of the codex binary if not on PATH
# WEAVE_PROJECT=trust-agentic-commerce
