# Copy to .env and fill in to switch from MOCK mode to REAL agents.
# With NO keys set, everything still runs on deterministic mock data.

# Anthropic -- unlocks real red (generation) + blue (analysis) agents
ANTHROPIC_API_KEY=

# Weights & Biases / Weave -- unlocks live tracing in tracing.py
WANDB_API_KEY=

# Optional overrides
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
# WEAVE_PROJECT=trust-agentic-commerce
